# Dependencies
node_modules/
backend/node_modules/

# Build outputs
backend/dist/
backend/dist-server/
build/

# Pipeline working data (regenerated by `node pipeline/build.js`; published via
# the GitHub Action, never committed). The ~48MB raw downloads and the 34MB
# dist/ output both stay out of git.
pipeline/raw/
pipeline/dist/

# GitHub Pages assembly dir (built in CI)
_site/

# Environment / secrets — never commit these
.env
.env.*

# Archives
*.zip
*.tgz

# Logs
*.log
npm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
