    "@vitejs/plugin-react": "^5.1.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jimp": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
